# The browser never receives a container IP or port. Runtime traffic is routed
# through the cloud control plane using the selected workspace ID.
VITE_NEBULA_RUNTIME_GATEWAY_BASE=/api/workspaces

# Leave empty when Web and the control plane share an origin. Set this only
# when developing against a separately hosted control plane.
VITE_NEBULA_CONTROL_PLANE_BASE=

# Local development gateway target. The browser still uses
# /api/workspaces/:workspaceId/runtime/*; Vite proxies that route server-side.
NEBULA_RUNTIME_ORIGIN=http://127.0.0.1:7777
# Optional. When empty, development reads ~/.nebula/http-token.
NEBULA_HTTP_TOKEN=
