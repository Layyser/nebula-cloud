# The control plane binds locally unless explicitly exposed by deployment.
NEBULA_CLOUD_BIND=127.0.0.1
NEBULA_CLOUD_PORT=7790
NEBULA_CLOUD_VERSION=dev
NEBULA_CLOUD_DATABASE_PATH=./data/nebula-cloud.sqlite

# Generate a unique production secret with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional separate HMAC key for organization access codes. Production should
# use a distinct random secret; local development falls back to BETTER_AUTH_SECRET.
NEBULA_ORGANIZATION_CODE_SECRET=replace-with-a-second-random-secret
BETTER_AUTH_URL=http://127.0.0.1:7790
NEBULA_CLOUD_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public browser origin used in verification, recovery, invitation links, and
# opaque `/p/*` workspace publication URLs. The reverse proxy must forward
# `/p/*` to this control plane as well as `/api/*`.
NEBULA_PUBLIC_APP_URL=http://localhost:5173
# Optional dedicated publication origin. When set, Cloud returns URLs such as
# `https://<opaque-slug>.apps.nubols.com` and treats exactly one label beneath
# this hostname as publication traffic. The ingress must terminate wildcard TLS
# and preserve the original Host header. Leave unset to retain `/p/<slug>` URLs.
# NEBULA_PUBLISHED_SERVICE_ORIGIN=https://apps.nubols.com
# Local development can write complete messages (including one-time links) to
# private files. Keep disabled in production until a transactional provider is
# configured; never expose or commit the outbox.
NEBULA_EMAIL_TRANSPORT=disabled
NEBULA_EMAIL_OUTBOX_DIR=./data/email-outbox
NEBULA_REQUIRE_EMAIL_VERIFICATION=false
# Production transport example. Keep the API key in the deployment secret
# store, not in this file or the database.
# NEBULA_EMAIL_TRANSPORT=resend
# RESEND_API_KEY=re_replace_me
# NEBULA_EMAIL_FROM=Nubols <account@send.nubols.com>
# Fixed internal recipient for public contact requests; user input is only used
# as a validated Reply-To value and can never choose the recipient.
NEBULA_CONTACT_TO_EMAIL=sales@nubols.com
# Generate separately with `openssl rand -base64 32` in production. It hashes
# request source addresses before durable rate-limit storage.
NEBULA_CONTACT_SOURCE_HASH_SECRET=replace-with-a-third-random-secret
# Accepted contact requests are deleted after this many days. Update the public
# notice and role-mailbox policy before changing it. Invalid, blocked, and
# honeypot submissions are never persisted.
NEBULA_CONTACT_RETENTION_DAYS=730

# Optional authenticated worker host. Configure both values to seed the local
# durable worker registry and enable provisioning. Capacity values describe
# the host scheduler ceiling; workspace reservation values match the worker's
# current default hard limits.
NEBULA_WORKER_URL=http://127.0.0.1:7780
NEBULA_WORKER_TOKEN=replace-with-the-worker-service-token
NEBULA_WORKER_ID=local-worker
NEBULA_WORKER_CREDENTIAL_KEY_ID=local-worker-token
# Additional registered workers resolve their credential key IDs from this
# root-readable JSON object. Restart the control plane after rotating it.
# NEBULA_WORKER_CREDENTIALS_FILE=/run/secrets/nebula-worker-credentials.json
NEBULA_WORKER_PROVIDER=local
NEBULA_WORKER_REGION=local
NEBULA_WORKER_TOTAL_MEMORY_BYTES=17179869184
NEBULA_WORKER_TOTAL_CPU_MILLIS=8000
NEBULA_WORKER_TOTAL_DISK_BYTES=107374182400
NEBULA_WORKER_TOTAL_WORKSPACE_SLOTS=4
NEBULA_WORKSPACE_MEMORY_RESERVATION_BYTES=4294967296
NEBULA_WORKSPACE_CPU_RESERVATION_MILLIS=2000
NEBULA_WORKSPACE_DISK_RESERVATION_BYTES=5368709120
NEBULA_WORKSPACE_IMAGE=nebula-workspace:dev
NEBULA_WORKER_HEALTH_INTERVAL_MS=10000
NEBULA_WORKER_HEALTH_TIMEOUT_MS=5000
NEBULA_WORKER_HEARTBEAT_STALE_MS=30000

# Internal worker-registry and contact-request administration. Keep these
# routes private and use a unique deployment secret; it is not an
# organization-admin credential.
NEBULA_PLATFORM_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Optional local-development account used by `bun run bootstrap`.
# Never commit real bootstrap credentials.
# NEBULA_BOOTSTRAP_NAME=Jorge
# NEBULA_BOOTSTRAP_EMAIL=jorge@example.com
# NEBULA_BOOTSTRAP_PASSWORD=replace-with-a-local-password
