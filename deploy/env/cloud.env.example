NODE_ENV=production
NEBULA_CLOUD_BIND=127.0.0.1
NEBULA_CLOUD_PORT=7790
NEBULA_CLOUD_TRUST_LOCAL_PROXY=true
NEBULA_CLOUD_DATABASE_PATH=/var/lib/nubols-cloud/nebula-cloud.sqlite
NEBULA_PUBLIC_APP_URL=https://app.nubols.com
NEBULA_PUBLISHED_SERVICE_ORIGIN=https://apps.nubols.com
BETTER_AUTH_URL=https://app.nubols.com
NEBULA_CLOUD_TRUSTED_ORIGINS=https://nubols.com,https://app.nubols.com
NEBULA_REQUIRE_EMAIL_VERIFICATION=true
NEBULA_SIGNUP_ALLOWED_EMAILS=beta@nubols.com
NEBULA_EMAIL_TRANSPORT=resend
NEBULA_EMAIL_FROM=Nubols <beta@nubols.com>
NEBULA_TCP_INGRESS_ENABLED=true
NEBULA_TCP_INGRESS_BIND=0.0.0.0
NEBULA_TCP_INGRESS_HOST=tcp.nubols.com
NEBULA_TCP_INGRESS_PORT_MIN=20000
NEBULA_TCP_INGRESS_PORT_MAX=20099
NEBULA_WORKER_URL=http://127.0.0.1:7780
NEBULA_WORKER_ID=worker-1
NEBULA_WORKER_PROVIDER=ovhcloud
NEBULA_WORKER_REGION=erith
NEBULA_WORKER_TOTAL_MEMORY_BYTES=6442450944
NEBULA_WORKER_TOTAL_CPU_MILLIS=4000
NEBULA_WORKER_TOTAL_DISK_BYTES=32212254720
NEBULA_WORKER_TOTAL_WORKSPACE_SLOTS=1
NEBULA_WORKSPACE_MEMORY_RESERVATION_BYTES=6442450944
NEBULA_WORKSPACE_CPU_RESERVATION_MILLIS=4000
NEBULA_WORKSPACE_DISK_RESERVATION_BYTES=32212254720
NEBULA_WORKSPACE_IMAGE=nebula-workspace:REPLACE_IMMUTABLE_REVISION
# Supply secrets through root-owned deployment tooling:
# BETTER_AUTH_SECRET, NEBULA_ORGANIZATION_CODE_SECRET,
# NEBULA_CONTACT_SOURCE_HASH_SECRET, NEBULA_PLATFORM_ADMIN_TOKEN,
# NEBULA_WORKER_TOKEN, RESEND_API_KEY, RESEND_WEBHOOK_SECRET,
# STRIPE_WEBHOOK_SECRET (only when sandbox billing is enabled).
