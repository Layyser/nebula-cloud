NEBULA_WORKER_TOTAL_MEMORY_BYTES=6GiB
NEBULA_WORKER_TOTAL_CPU_MILLIS=4000
NEBULA_WORKER_TOTAL_DISK_BYTES=30GiB
NEBULA_WORKER_TOTAL_WORKSPACE_SLOTS=1
NEBULA_WORKER_DEFAULT_MEMORY_REQUEST=2GiB
NEBULA_WORKER_DEFAULT_MEMORY_LIMIT=6GiB
NEBULA_WORKER_DEFAULT_CPU_REQUEST=1
NEBULA_WORKER_DEFAULT_CPU_LIMIT=4
NEBULA_WORKER_DEFAULT_PIDS_LIMIT=1024
NEBULA_WORKER_DEFAULT_DISK_LIMIT=30GiB
NEBULA_WORKER_MAX_MEMORY_LIMIT=6GiB
NEBULA_WORKER_MAX_CPU_LIMIT=4
