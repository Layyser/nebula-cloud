#!/usr/bin/env bash
set -euo pipefail

# Read-only GitHub credential helper for manual release updates. The token is
# deliberately kept outside the repositories and is never written to Git's
# credential store or included in a remote URL.
case "${1:-get}" in
  get) ;;
  store|erase) exit 0 ;;
  *) exit 1 ;;
esac

credentials_file="${NUBOLS_GITHUB_CREDENTIALS_FILE:-/home/ubuntu/.config/nubols/github.env}"
if [[ ! -r "$credentials_file" ]]; then
  exit 1
fi

# shellcheck disable=SC1090
source "$credentials_file"
if [[ -z "${GITHUB_TOKEN:-}" ]]; then
  exit 1
fi

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n\n' "$GITHUB_TOKEN"
